# --- model providers -------------------------------------------------------
# A definition names its own provider and model; these are the credentials this
# service presents. Each is optional: without one, definitions using that
# provider are refused with the reason stated, and every other definition works.

# Claude.
ANTHROPIC_API_KEY=

# ChatGPT. Also used for any OpenAI compatible provider that names no endpoint.
OPENAI_API_KEY=

# Default endpoint for OpenAI compatible providers, when the model names none.
# Empty means api.openai.com. Point this at a local server to run open models:
#   Ollama    http://localhost:11434/v1
#   vLLM      http://localhost:8000/v1
#   LM Studio http://localhost:1234/v1
OPENAI_BASE_URL=

# Key for a model that names its own endpoint. Separate from OPENAI_API_KEY so a
# key meant for a local or third party server is never sent to OpenAI. Most self
# hosted servers need nothing here.
OPEN_MODEL_API_KEY=

# --- server ----------------------------------------------------------------
# Shared secret the gateway sends as X-MCP-Token. Empty leaves those routes open.
PUBLISHER_TOKEN=

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- executor ---------------------------------------------------------------
# RabbitMQ, where executable jobs are published for mcp-action. Leave QUEUE_HOST
# empty and this service plans without ever causing anything to run.
QUEUE_HOST=127.0.0.1
QUEUE_PORT=5672
QUEUE_USER=
QUEUE_PASSWORD=
QUEUE_VHOST=/

# --- prompt routing ---------------------------------------------------------
# Which model picks a tool for a prompt. Separate from the models named on the
# definitions: nothing is chosen yet when this runs, so it cannot come from one.
ROUTER_PROVIDER=anthropic
ROUTER_ENDPOINT=
ROUTER_MODEL=claude-opus-5

# --- credentials ------------------------------------------------------------
# mcp-cipher opens a definition's own model API key, so a key entered once in the
# panel is the key this service calls with. Without it only the keys above work.
MCP_CIPHER_ADDRESS=127.0.0.1:9090
MCP_CIPHER_TOKEN=
